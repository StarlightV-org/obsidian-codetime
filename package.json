{
	"name": "obsidian-codetime",
	"version": "1.0.0",
	"description": "This is a plugin that integrates with CodeTime.dev to track your writing activity. This is not made by or affiliated with codetime.dev.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "MIT",
	"dependencies": {
		"@codemirror/view": "^6.43.8"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.66.0"
	}
}
